<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net8.0-windows\</OutputPath>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);Backup\**</DefaultItemExcludes>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ClipDesk</RootNamespace>
    <AssemblyName>ClipDesk</AssemblyName>
    <Version>0.3.3</Version>
    <AssemblyVersion>0.3.3.0</AssemblyVersion>
    <FileVersion>0.3.3.0</FileVersion>
    <ApplicationIcon>Resources\Brand\clipdesk.ico</ApplicationIcon>
    <ClipDeskEnvironment Condition="'$(ClipDeskEnvironment)' == ''">Development</ClipDeskEnvironment>
    <DefineConstants Condition="'$(ClipDeskEnvironment)' == 'Development'">$(DefineConstants);CLIPDESK_DEV</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Compile Remove="Core\**\*.cs;Tests\**\*.cs;Server\**\*.cs;Updater\**\*.cs;Installer\**\*.cs;tmp\**\*.cs;Models\Clipboard*.cs;Models\WorkspaceBoard.cs" />
    <Page Remove="Installer\**\*.xaml" />
    <ApplicationDefinition Remove="Installer\App.xaml" />
    <EmbeddedResource Remove="Installer\**\*" />
    <ProjectReference Include="Core\ClipDesk.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.31" />
    <PackageReference Include="Supabase" Version="8.1.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\Fonts\MaterialSymbolsRounded.ttf" />
    <Content Include="Resources\Fonts\MaterialSymbolsRounded.codepoints;Resources\Fonts\LICENSE-Material-Symbols.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Models\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Brand\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Icons\FontAwesome\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Icons\Lucide\LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="BuildUpdater" BeforeTargets="Publish">
    <MSBuild Projects="$(MSBuildProjectDirectory)\Updater\ClipDesk.Updater.csproj"
             Targets="Restore"
             Properties="RuntimeIdentifier=win-x64" />
    <MSBuild Projects="$(MSBuildProjectDirectory)\Updater\ClipDesk.Updater.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;EnableCompressionInSingleFile=true;PublishDir=$(MSBuildProjectDirectory)\Updater\bin\$(Configuration)\publish\" />
  </Target>
  <Target Name="CopyUpdaterToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Updater\bin\$(Configuration)\publish\ClipDesk.Updater.exe"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
