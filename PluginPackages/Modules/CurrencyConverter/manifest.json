{
  "manifestVersion": 2,
  "id": "clipdesk.currency-converter",
  "name": "Conversor de moedas",
  "description": "Converta valores e consulte cotações com atualização automática.",
  "version": "2.0.0",
  "publisher": "ClipDesk",
  "iconGlyph": "\ueb70",
  "accentColor": "#34D399",
  "runtime": "portable-v2",
  "pluginApiVersion": 2,
  "stateVersion": 1,
  "module": { "assembly": "ClipDesk.Plugin.CurrencyConverter.Core.dll", "type": "ClipDesk.Plugin.CurrencyConverter.CurrencyConverterModule" },
  "renderers": [{ "platform": "windows", "runtime": "wpf-v2", "assembly": "ClipDesk.Plugin.CurrencyConverter.dll", "type": "ClipDesk.Plugin.CurrencyConverter.CurrencyConverterPlugin" }],
  "minimumHostVersion": "0.3.3",
  "installByDefault": false,
  "sortOrder": 40,
  "defaultSize": { "width": 350, "height": 260 },
