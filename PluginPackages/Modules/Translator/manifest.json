{
  "manifestVersion": 2,
  "id": "clipdesk.translator",
  "name": "Tradutor",
  "description": "Traduza textos entre idiomas sem sair da sua mesa.",
  "version": "2.0.0",
  "publisher": "ClipDesk",
  "iconGlyph": "\ue8e2",
  "accentColor": "#38BDF8",
  "runtime": "portable-v2",
  "pluginApiVersion": 2,
  "stateVersion": 1,
  "module": { "assembly": "ClipDesk.Plugin.Translator.Core.dll", "type": "ClipDesk.Plugin.Translator.TranslatorModule" },
  "renderers": [{ "platform": "windows", "runtime": "wpf-v2", "assembly": "ClipDesk.Plugin.Translator.dll", "type": "ClipDesk.Plugin.Translator.TranslatorPlugin" }],
  "minimumHostVersion": "0.3.3",
  "installByDefault": false,
  "sortOrder": 30,
  "defaultSize": { "width": 370, "height": 270 },
  "defaultContent": { "$schema": "1", "sourceLanguage": "auto", "targetLanguage": "en", "input": "", "output": "A tradução aparece aqui" },
  "platforms": ["windows"],
  "capabilities": ["board-widget"],
  "networkHosts": ["api.mymemory.translated.net"],
  "permissions": ["network"]
}
