<Window x:Class="ClipDesk.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visualizacao"
        Width="760"
        Height="650"
        MinWidth="760"
        MinHeight="650"
        MaxWidth="760"
        MaxHeight="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="../Resources/Brand/clipdesk.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <DrawingBrush x:Key="DarkNoteLinesBrush"
                      TileMode="Tile"
                      Viewport="0,0,1,28"
                      ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#00283040">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,1,28" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#55E8EDF5" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="0,24" EndPoint="1,24" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="LightNoteLinesBrush"
                      TileMode="Tile"
                      Viewport="0,0,1,28"
                      ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#00DAE4F4">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,1,28" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#806F7C91" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="0,24" EndPoint="1,24" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="IconActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#26FFFFFF" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#34FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootSurface"
          Background="Transparent">
        <StackPanel x:Name="PreviewStack"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1" />
            </StackPanel.RenderTransform>
            <TextBlock x:Name="TitleText"
                       HorizontalAlignment="Center"
                       FontSize="56"
                       FontWeight="Light"
                       Foreground="#EFF4FA"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="640"
                       Margin="0,0,0,28" />

            <Border x:Name="PreviewPanel"
                    Width="640"
                    Height="470"
                    Background="#F0283040"
                    BorderBrush="#334A5568"
                    BorderThickness="1"
                    CornerRadius="54"
                    Padding="42,38">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36"
                                      ShadowDepth="12"
                                      Opacity="0.24"
                                      Color="#05080D" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="EditorSurface"
                            Background="#10283040"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            CornerRadius="26"
                            Padding="26,14"
                            Visibility="Collapsed">
                        <Grid>
                            <Rectangle x:Name="NoteLines"
                                       Fill="{StaticResource DarkNoteLinesBrush}"
                                       Margin="0,0,0,0"
                                       IsHitTestVisible="False" />
                            <TextBox x:Name="TextEditor"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#F8FAFC"
                                     SelectionBrush="#806E44E8"
                                     CaretBrush="#F8FAFC"
                                     FontFamily="Segoe UI"
                                     FontSize="20"
                                     FontWeight="Medium"
                                     Padding="0,0,10,0"
                                     SpellCheck.IsEnabled="False" />
                        </Grid>
                    </Border>

                    <Border x:Name="ImageSurface"
                            Background="#12FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            CornerRadius="26"
                            Padding="14"
                            Visibility="Collapsed">
                        <ScrollViewer x:Name="ImageScroller"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Image x:Name="PreviewImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </ScrollViewer>
                    </Border>

                    <Border x:Name="InfoSurface"
                            Background="#1018202C"
                            BorderBrush="#1FFFFFFF"
                            BorderThickness="1"
                            CornerRadius="26"
                            Padding="26"
                            Visibility="Collapsed">
                        <TextBlock x:Name="InfoText"
                                   TextWrapping="Wrap"
                                   FontSize="18"
                                   LineHeight="28"
                                   Foreground="#F8FAFC" />
                    </Border>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,2,0">
                        <Button x:Name="SaveButton"
                                Style="{StaticResource IconActionButtonStyle}"
                                Click="SaveButton_Click"
                                ToolTip="Salvar">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="26" />
                        </Button>
                        <Button Style="{StaticResource IconActionButtonStyle}"
                                Margin="10,0,0,0"
                                Click="CloseButton_Click"
                                ToolTip="Fechar">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
