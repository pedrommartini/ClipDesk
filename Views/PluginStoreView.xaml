<UserControl x:Class="ClipDesk.Views.PluginStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource StoreBackdropBrush}"
             Foreground="{DynamicResource TextBrush}"
             SizeChanged="PluginStoreView_SizeChanged">
    <UserControl.Resources>
        <FontFamily x:Key="PluginMaterialSymbols">/ClipDesk;component/Resources/Fonts/#Material Symbols Rounded</FontFamily>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource StoreCardHoverBrush}" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource StoreAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource StoreAccentBrush}" />
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PluginCardSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource StoreCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StoreCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource StoreCardHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StoreAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PluginSplitActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource StoreActionTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource StoreAccentWashBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource StoreAccentWashBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="Track" IsDirectionReversed="True" Focusable="False">
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource MutedBrush}" Opacity="0.38">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface" Background="{TemplateBinding Background}" CornerRadius="4" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Opacity" Value="0.82" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource StoreBackdropBrush}" ClipToBounds="True">
        <Grid x:Name="ContentGrid" Margin="42,28,42,30" MaxWidth="1240" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StoreTitle" Text="Plugins"
                               FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="StoreSubtitle"
                               Text="Ferramentas para a sua mesa"
                               Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Width="36" Height="36" Padding="0" Margin="18,0,0,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="CloseButton_Click" ToolTip="Fechar loja (Esc)"
                        AutomationProperties.Name="Fechar loja de plugins">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <Border x:Name="SearchSurface" Grid.Row="1" Height="42" Width="380"
                    HorizontalAlignment="Left" Margin="0,22,0,22"
                    Background="{DynamicResource StoreCardBrush}"
                    BorderBrush="{DynamicResource StoreCardBorderBrush}"
                    BorderThickness="1" CornerRadius="11" Padding="13,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,11,0"
                               VerticalAlignment="Center" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                 FontSize="13" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 AutomationProperties.Name="Pesquisar plugins" />
                        <TextBlock Text="Pesquisar plugins" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer x:Name="StoreScroller" Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                <Grid Margin="0,2,0,0">
                    <StackPanel x:Name="CatalogView">
                        <Border Background="{DynamicResource StoreCardBrush}"
                                BorderBrush="{DynamicResource StoreCardBorderBrush}"
                                BorderThickness="1" CornerRadius="15" Margin="0,0,0,23">
                            <Grid>
                                <Grid x:Name="InstalledSummaryLayout" Margin="17,13,16,13">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="InstalledSummaryIcon" Width="40" Height="40" CornerRadius="11"
                                            Background="{DynamicResource StoreAccentWashBrush}">
                                        <TextBlock Text="&#xE87B;" FontFamily="{StaticResource PluginMaterialSymbols}"
                                                   FontSize="20" Foreground="{DynamicResource StoreAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel x:Name="InstalledSummaryCopy" Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="InstalledSummaryTitle" Text="4 plugins instalados"
                                                   FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Tudo pronto para adicionar à mesa."
                                                   Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                    </StackPanel>
                                    <Button x:Name="ShowInstalledButton" Grid.Column="2" Height="34" MinWidth="130"
                                            Padding="12,0" Background="{DynamicResource StoreAccentWashBrush}"
                                            BorderBrush="{DynamicResource StoreCardBorderBrush}"
                                            Click="ShowInstalledButton_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Ver instalados" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="7,1,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,13">
                            <StackPanel>
                                <TextBlock Text="Todos os plugins" FontSize="19" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="CatalogCountText" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </Grid>
                        <WrapPanel x:Name="PluginCardsPanel" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel x:Name="InstalledView" Visibility="Collapsed">
                        <Button x:Name="InstalledBackButton" Width="96" Height="34" HorizontalAlignment="Left" Padding="10,0"
                                Background="{DynamicResource StoreCardBrush}"
                                BorderBrush="{DynamicResource StoreCardBorderBrush}"
                                Click="InstalledBackButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,1,9,0" />
                                <TextBlock Text="Voltar" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Plugins instalados" Margin="0,20,0,4" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock x:Name="InstalledCountText" Margin="0,0,0,17" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}" />
                        <WrapPanel x:Name="InstalledCardsPanel" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,70,0,0">
                        <Border Width="48" Height="48" CornerRadius="13" Background="{DynamicResource StoreAccentWashBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{DynamicResource StoreAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Nenhum plugin encontrado" Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Tente pesquisar usando outro nome."
                                   Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
