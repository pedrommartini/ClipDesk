<Window x:Class="ClipDesk.Views.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ClipDesk.Models;assembly=ClipDesk.Core"
        Title="Pasta"
        Width="620"
        Height="460"
        MinWidth="460"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="#F4F4F2">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#25282D"
                   Margin="0,0,0,16" />

        <Border Grid.Row="1"
                Background="#CCFFFFFF"
                BorderBrush="#E1E5EA"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16">
            <ListBox x:Name="ItemsList"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Single"
                     MouseMove="ItemsList_MouseMove"
                     MouseDoubleClick="ItemsList_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="122" />
                        <Setter Property="Height" Value="138" />
                        <Setter Property="Margin" Value="8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ClipboardItem}">
                        <Grid>
                            <Border Width="78"
                                    Height="78"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,4,0,0"
                                    Background="#2477F2"
                                    CornerRadius="18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.14" />
                                </Border.Effect>
                                <TextBlock Text="{Binding Type}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="{Binding DisplayName}"
                                       Margin="2,90,2,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="#34373D"
                                       MaxHeight="38" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
