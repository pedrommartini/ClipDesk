<Window x:Class="ClipDesk.Views.ClipboardPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClipDesk.Views"
        Title="ClipDesk — Histórico rápido" Width="380" Height="540"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource SurfaceBrush}" PreviewKeyDown="Window_KeyDown">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <views:HistoryView x:Name="History" />
    </Border>
</Window>
