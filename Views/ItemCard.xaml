<UserControl x:Class="ClipDesk.Views.ItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClipDesk.Views"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Width="320" Height="210" MinWidth="240" MinHeight="156" MaxWidth="680" MaxHeight="520"
             FontFamily="Segoe UI Variable Display, Segoe UI" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
             Focusable="True"
             MouseLeftButtonDown="Card_MouseLeftButtonDown"
             MouseMove="Card_MouseMove"
             MouseLeftButtonUp="Card_MouseLeftButtonUp"
             MouseRightButtonDown="Card_MouseRightButtonDown">
    <UserControl.Resources>
        <FontFamily x:Key="MaterialSymbols">/ClipDesk;component/Resources/Fonts/#Material Symbols Rounded</FontFamily>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E4DDFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#287F6AB0" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#457F6AB0" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Root" Margin="8" RenderTransformOrigin="0,0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WorkspaceScale" ScaleX="1" ScaleY="1" />
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="CardShadowSurface" Background="#F71D2432" BorderBrush="#51627A" BorderThickness="1" CornerRadius="17">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="22" ShadowDepth="7" Opacity="0.24" Color="#020617" />
            </Border.Effect>
        </Border>
        <Rectangle x:Name="SelectionRing" Stroke="#94A3B8" StrokeThickness="2" StrokeDashArray="5 3" RadiusX="17" RadiusY="17" Opacity="0" IsHitTestVisible="False" />
        <Border x:Name="DropTargetRing" Margin="-3" BorderBrush="#A78BFA" BorderThickness="3" CornerRadius="20" Opacity="0" IsHitTestVisible="False" />

        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderLayout" Margin="18,10,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="IconColumn" Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Border x:Name="HeaderIcon" Width="38" Height="38" HorizontalAlignment="Left" CornerRadius="9">
                    <TextBlock x:Name="GlyphText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <Grid Grid.Column="1" Margin="9,0,8,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" TextTrimming="CharacterEllipsis" FontSize="20" FontWeight="Normal" Foreground="#F8FAFC" MouseLeftButtonDown="NameText_MouseLeftButtonDown" />
                        <TextBlock x:Name="FolderCount" Visibility="Collapsed" Margin="0,4,0,0" FontSize="16" Foreground="#C2BDF1" />
                    </StackPanel>
                    <TextBox x:Name="NameEditor" VerticalAlignment="Center" Height="32" Padding="6,3" FontSize="14" FontWeight="SemiBold" Background="#F02A3345" BorderBrush="#8B5CF6" BorderThickness="1" Foreground="#F8FAFC" Visibility="Collapsed" LostFocus="NameEditor_LostFocus" PreviewKeyDown="NameEditor_PreviewKeyDown" />
                </Grid>
                <Button x:Name="MoreButton" Grid.Column="2" Width="32" Height="32" Padding="0" Click="MoreButton_Click" ToolTip="Ações">
                    <TextBlock Text="⋮" FontFamily="Segoe UI" FontSize="24" />
                </Button>
            </Grid>

            <Border x:Name="PreviewSurface" Grid.Row="1" Margin="16,0,16,16" Background="Transparent" BorderThickness="0" CornerRadius="10" ClipToBounds="True">
                <Grid>
                    <Grid x:Name="TextPreview" Visibility="Collapsed" Margin="4,3">
                        <TextBlock x:Name="TextPreviewContent" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="16" LineHeight="25" Foreground="#DCE6F3" />
                    </Grid>
                    <Border x:Name="ImagePreviewHost" Visibility="Collapsed" Background="Transparent">
                        <local:PreviewImage x:Name="ImagePreview" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>
                    <Grid x:Name="LinkPreview" Visibility="Collapsed" Margin="4,4">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Link copiado" FontSize="13" Foreground="#B9ACEA" />
                        <TextBlock x:Name="LinkPreviewContent" Grid.Row="1" Margin="0,7,0,0" VerticalAlignment="Top" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="16" LineHeight="24" Foreground="#DCE6F3" />
                    </Grid>
                    <Grid x:Name="FilePreview" Visibility="Collapsed" Margin="15,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="FileBadge" Width="48" Height="58" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="9">
                            <TextBlock x:Name="FileBadgeText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="12" FontWeight="Bold" TextAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FilePreviewName" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" />
                            <TextBlock x:Name="FilePreviewMeta" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#94A3B8" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="FolderPreviewScroller" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Margin="0">
                        <WrapPanel x:Name="FolderPreview" />
                    </ScrollViewer>
                    <Grid x:Name="GenericPreview" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="GenericGlyph" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TypeLabel" Margin="0,7,0,0" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Rectangle x:Name="CollaboratorSelection" StrokeThickness="1.5" StrokeDashArray="5 3" RadiusX="17" RadiusY="17" Visibility="Collapsed" IsHitTestVisible="False" />
        <Path x:Name="CloudSavedGlyph" Data="M 1,7 L 5,11 L 13,2" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,20" Visibility="Collapsed" IsHitTestVisible="False" />
        <Button x:Name="CloudFileAction" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,14" Visibility="Collapsed" Click="CloudFileAction_Click" ToolTip="Enviar ao Drive">
            <TextBlock x:Name="CloudFileGlyph" Text="&#xE2C3;" FontFamily="{StaticResource MaterialSymbols}" FontSize="18" Foreground="{DynamicResource MutedBrush}" />
        </Button>
        <Border x:Name="CopiedGlow" Margin="-2" BorderBrush="#34D399" BorderThickness="3" CornerRadius="20" Opacity="0" IsHitTestVisible="False" />
        <Border x:Name="PluginFoldCrease" Width="3" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                CornerRadius="2" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00C7F9E8" Offset="0" />
                    <GradientStop Color="#75C7F9E8" Offset="0.5" />
                    <GradientStop Color="#00C7F9E8" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border x:Name="QuickActions" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,8,0" Background="#F4263040" BorderBrush="#56647A" BorderThickness="1" CornerRadius="13" Padding="6" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.9,0">
            <Border.RenderTransform><ScaleTransform x:Name="QuickActionsScale" ScaleX="0.86" ScaleY="0.86" /></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.3" Color="#020617" /></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button Width="32" Height="30" Padding="0" Margin="0,0,4,0" Click="QuickCopy_Click" ToolTip="Copiar"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" /></Button>
                <Button Width="32" Height="30" Padding="0" Margin="0,0,4,0" Click="QuickDuplicate_Click" ToolTip="Duplicar"><TextBlock Text="2×" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" /></Button>
                <Button Width="32" Height="30" Padding="0" Margin="0,0,4,0" Click="QuickDetails_Click" ToolTip="Detalhes"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" /></Button>
                <Button Width="32" Height="30" Padding="0" Margin="0,0,4,0" Click="QuickDelete_Click" ToolTip="Excluir"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" /></Button>
                <Button Width="32" Height="30" Padding="0" Margin="0,0,4,0" Click="QuickBringForward_Click" ToolTip="Subir uma camada"><TextBlock Text="&#xE5D8;" FontFamily="{StaticResource MaterialSymbols}" FontSize="18" /></Button>
                <Button Width="32" Height="30" Padding="0" Click="QuickSendBackward_Click" ToolTip="Descer uma camada"><TextBlock Text="&#xE5DB;" FontFamily="{StaticResource MaterialSymbols}" FontSize="18" /></Button>
            </StackPanel>
        </Border>

        <primitives:Thumb x:Name="ResizeThumb" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 7,17 L 17,7 M 12,18 L 18,12" Stroke="#8094A3B8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
    </Grid>
</UserControl>
