<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ClipDeskEnvironment Condition="'$(ClipDeskEnvironment)' == ''">Development</ClipDeskEnvironment>
    <DefineConstants Condition="'$(ClipDeskEnvironment)' == 'Development'">$(DefineConstants);CLIPDESK_DEV</DefineConstants>
    <AssemblyName Condition="'$(ClipDeskEnvironment)' == 'Development'">ClipDesk-DEV-Setup</AssemblyName>
    <AssemblyName Condition="'$(ClipDeskEnvironment)' != 'Development'">ClipDesk-Setup</AssemblyName>
    <RootNamespace>ClipDesk.Installer</RootNamespace>
    <Version>0.4.2</Version>
    <FileVersion>0.4.2.0</FileVersion>
    <ApplicationIcon>..\Resources\Brand\clipdesk.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\Resources\Brand\clipdesk-icon.png" Link="Resources\Brand\clipdesk-icon.png" />
    <Resource Include="..\Resources\Brand\clipdesk-logo.png" Link="Resources\Brand\clipdesk-logo.png" />
    <EmbeddedResource Include="Payload\ClipDeskPayload.zip" LogicalName="ClipDeskPayload.zip" />
  </ItemGroup>
</Project>
