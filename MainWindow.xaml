<Window x:Class="ClipDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClipDesk.Views"
        Title="ClipDesk"
        Icon="Resources/Brand/clipdesk.ico"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowState="Maximized"
        Background="#F4F4F2"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        SizeChanged="MainWindow_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.FontFamily>Segoe UI Variable Text</Window.FontFamily>
    <Window.Resources>
        <DrawingBrush x:Key="GridBrush"
                      TileMode="Tile"
                      Viewport="0,0,32,32"
                      ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F4F4F2">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#E3E5E8" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="32,0" EndPoint="32,32" />
                                <LineGeometry StartPoint="0,32" EndPoint="32,32" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#25282D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#22000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#33000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ZoomSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="5,0">
                            <Track x:Name="PART_Track" VerticalAlignment="Center" Height="20">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" VerticalAlignment="Center" Background="#9B8AFB" CornerRadius="2" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" VerticalAlignment="Center" Background="#435063" CornerRadius="2" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="SizeWE">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#A78BFA" Stroke="#EDE9FE" StrokeThickness="2"><Ellipse.Effect><DropShadowEffect BlurRadius="7" Opacity="0.35" ShadowDepth="1" Color="#7C3AED" /></Ellipse.Effect></Ellipse></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="SplitLayout" Background="{DynamicResource SurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="HistoryColumn" Width="0" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="480" />
        </Grid.ColumnDefinitions>
        <views:HistoryView x:Name="HistoryPane" Visibility="Collapsed" />
        <GridSplitter x:Name="HistorySplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />
    <Grid x:Name="Root" Grid.Column="2"
          AllowDrop="True"
          Background="{StaticResource GridBrush}"
          PreviewDragOver="Window_DragOver"
          PreviewDrop="Window_Drop"
          PreviewDragLeave="Window_DragLeave"
          SizeChanged="Root_SizeChanged"
          MouseDown="Root_MouseDown">
        <ScrollViewer x:Name="WorkspaceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="WorkspaceScroll_SizeChanged">
        <Canvas x:Name="WorkspaceCanvas"
                AllowDrop="True"
                Background="Transparent"
                ClipToBounds="True"
                PreviewDragOver="Window_DragOver"
                PreviewDrop="Window_Drop"
                PreviewDragLeave="Window_DragLeave"
                SizeChanged="WorkspaceCanvas_SizeChanged" />
        </ScrollViewer>

        <Border x:Name="HistoryDropGlow"
                Margin="18"
                Background="#167046CB"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="20"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock x:Name="HistoryDropGlowText" Text="Solte para adicionar à mesa" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="16" />
        </Border>

        <Grid x:Name="HeaderBar" Height="44" Margin="24,17,126,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Panel.ZIndex="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BrandColumn" Width="112" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="WorkspaceColumn" Width="174" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ZoomColumn" Width="172" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image x:Name="BrandMark" Source="Resources/Brand/clipdesk-icon.png" Width="24" Height="24" Stretch="Uniform" />
                <TextBlock x:Name="BrandNameText" Text="ClipDesk" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>

        <Border x:Name="TopToolbar" Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="0"
                Background="#B8FFFFFF"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.12" Color="#475569" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="UndoButton"
                        Width="27"
                        Height="27"
                        Margin="0,0,4,0"
                        Padding="0"
                        Click="UndoButton_Click"
                        ToolTip="Desfazer">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <Button x:Name="RedoButton"
                        Width="27"
                        Height="27"
                        Margin="0,0,4,0"
                        Padding="0"
                        Click="RedoButton_Click"
                        ToolTip="Refazer">
                    <TextBlock Text="&#xE72A;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <Button Width="27"
                        Height="27"
                        Margin="0,0,4,0"
                        Padding="0"
                        Click="HistoryButton_Click"
                        ToolTip="Histórico do clipboard">
                    <TextBlock Text="&#xE823;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <Button x:Name="ThemeButton"
                        Width="27"
                        Height="27"
                        Padding="0"
                        Click="ThemeButton_Click"
                        ToolTip="Modo claro/escuro">
                    <TextBlock x:Name="ThemeIcon"
                               Text="&#xE708;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <Button x:Name="StartupButton"
                        Width="27"
                        Height="27"
                        Margin="4,0,0,0"
                        Padding="0"
                        Click="StartupButton_Click"
                        ToolTip="Iniciar com o Windows">
                    <Grid Width="15" Height="15" ToolTip="">
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="#5D77E8" Margin="0,0,1,1" />
                        <Border Grid.Row="0" Grid.Column="1" Background="#7E8EF1" Margin="1,0,0,1" />
                        <Border Grid.Row="1" Grid.Column="0" Background="#8B6DEB" Margin="0,1,1,0" />
                        <Border Grid.Row="1" Grid.Column="1" Background="#B59AFF" Margin="1,1,0,0" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

            <Button x:Name="WorkspaceButton" Grid.Column="2" Height="36" Margin="12,0,10,0" Padding="7,0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="WorkspaceButton_Click" ToolTip="Trocar mesa">
                <StackPanel Orientation="Horizontal" Opacity="0.8">
                    <TextBlock x:Name="WorkspaceNameText" Text="Mesa principal" MaxWidth="130" TextTrimming="CharacterEllipsis" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="9,3,0,0" />
                </StackPanel>
            </Button>

            <Border x:Name="ZoomSurface" Grid.Column="4" Height="40" VerticalAlignment="Center" Background="#A81B2230" BorderBrush="#50647A" BorderThickness="1" CornerRadius="20" Padding="11,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                    <TextBlock Text="−" FontSize="18" Foreground="#AAB7C8" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="50" Maximum="100" Value="100" SmallChange="5" LargeChange="10" Style="{StaticResource ZoomSliderStyle}" ValueChanged="ZoomSlider_ValueChanged" ToolTip="Tamanho dos elementos" />
                    <TextBlock x:Name="ZoomValueText" Grid.Column="2" Text="100%" Foreground="#D8D4F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="WorkspaceSearchSurface" Width="390" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,19,0,0" Panel.ZIndex="22" Background="#A81B2230" BorderBrush="#50647A" BorderThickness="1" CornerRadius="20">
            <Grid Margin="13,0,12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#AAB7C8" VerticalAlignment="Center" />
                <TextBox x:Name="WorkspaceSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" CaretBrush="#A78BFA" FontSize="14" VerticalContentAlignment="Center" TextChanged="WorkspaceSearchBox_TextChanged" />
                <TextBlock x:Name="WorkspaceSearchPlaceholder" Grid.Column="1" Text="Pesquisar na mesa" Foreground="#8090A5" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock x:Name="WorkspaceSearchCount" Grid.Column="2" Foreground="#9385C4" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border x:Name="WorkspaceDropdown"
                Width="308"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="326,76,0,0"
                Padding="16"
                Background="#E91D2432"
                BorderBrush="#52647A"
                BorderThickness="1"
                CornerRadius="18"
                Visibility="Collapsed"
                Opacity="0"
                Panel.ZIndex="50"
                RenderTransformOrigin="0.12,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="WorkspaceDropdownScale" ScaleX="0.96" ScaleY="0.96" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.28" Color="#020617" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="MESA ATUAL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="WorkspaceDropdownTitle" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="WorkspaceDropdownEditButton" Grid.Column="1" Width="32" Height="32" Padding="0" Click="WorkspaceEditButton_Click" ToolTip="Editar nome da mesa">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                    </Button>
                </Grid>
                <Border Height="1" Margin="0,20,0,14" Background="#3564748B" />
                <StackPanel x:Name="WorkspaceDropdownItems" />
                <Border Height="1" Margin="0,14,0,10" Background="#3564748B" />
                <StackPanel x:Name="WorkspaceDropdownActions" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="WorkspaceEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="330">
            <TextBlock Text="Sua mesa, suas ideias." FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextAlignment="Center" />
            <TextBlock Text="Cole com Ctrl+V ou arraste itens do histórico para organizar seu próximo trabalho." Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
        <Border x:Name="TrashZone"
                Width="92"
                Height="98"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,17,18,0"
                Background="#44FFFFFF"
                BorderBrush="#9AA0A8"
                BorderThickness="2"
                CornerRadius="18"
                Opacity="0.78"
                MouseLeftButtonDown="TrashZone_MouseLeftButtonDown"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="TrashScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TrashIcon"
                           Text="&#xE74D;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="34"
                           Foreground="#737983"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="TrashLabel"
                           Text="Lixeira"
                           FontSize="15"
                           FontWeight="Medium"
                           Foreground="#34373D"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Grid x:Name="FolderOverlay"
              Visibility="Collapsed"
              Opacity="0"
              Background="#B8F4F4F2"
              AllowDrop="True"
              DragOver="FolderOverlay_DragOver"
              Drop="FolderOverlay_Drop"
              MouseMove="FolderOverlay_MouseMove"
              MouseLeftButtonUp="FolderOverlay_MouseLeftButtonUp"
              MouseDown="FolderOverlay_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="84,30,84,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Name="FolderBackButton" Width="40" Height="40" Padding="0" Margin="0,0,12,0" Visibility="Collapsed" Click="FolderBackButton_Click" ToolTip="Categorias">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                </Button>
                <TextBlock x:Name="FolderOverlayTitle"
                           Grid.Column="1"
                           TextAlignment="Left"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#F8FAFC"
                           Cursor="IBeam"
                           MouseLeftButtonDown="FolderOverlayTitle_MouseLeftButtonDown" />
                <TextBox x:Name="FolderOverlayTitleEditor"
                         Grid.Column="1"
                         MinWidth="260"
                         MaxWidth="620"
                         HorizontalAlignment="Left"
                         FontSize="30"
                         FontWeight="SemiBold"
                         TextAlignment="Left"
                         Background="#22FFFFFF"
                         BorderBrush="#66FFFFFF"
                         BorderThickness="0,0,0,2"
                         Foreground="#FAFFFFFF"
                         Visibility="Collapsed"
                         LostFocus="FolderOverlayTitleEditor_LostFocus"
                         PreviewKeyDown="FolderOverlayTitleEditor_PreviewKeyDown" />
            </Grid>

            <Border x:Name="FolderPanel"
                    Grid.Row="1"
                    Margin="80,0,80,42"
                    MaxWidth="980"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#F21D2432"
                    BorderBrush="#59647A"
                    BorderThickness="1"
                    CornerRadius="28"
                    Padding="22"
                    MouseDown="FolderPanel_MouseDown"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="FolderPanelScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" ShadowDepth="10" Opacity="0.3" Color="#020617" />
                </Border.Effect>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FolderItemsHost" />
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="WorkspaceNameOverlay"
              Visibility="Collapsed"
              Opacity="0"
              Background="#B8000000"
              Panel.ZIndex="100"
              MouseDown="WorkspaceNameOverlay_MouseDown">
            <Border x:Name="WorkspaceNameDialog"
                    Width="430"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F21D2636"
                    BorderBrush="#66788AA3"
                    BorderThickness="1"
                    CornerRadius="24"
                    RenderTransformOrigin="0.5,0.5"
                    MouseDown="WorkspaceNameDialog_MouseDown">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="WorkspaceNameDialogScale" ScaleX="0.94" ScaleY="0.94" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="42" ShadowDepth="14" Opacity="0.42" Color="#020617" />
                </Border.Effect>
                <StackPanel>
                    <Border Width="46" Height="46" HorizontalAlignment="Left" Background="#8B5CF6" CornerRadius="13">
                        <TextBlock x:Name="WorkspaceNameDialogIcon" Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="WorkspaceNameDialogTitle" Text="Criar nova mesa" Margin="0,18,0,0" FontSize="24" FontWeight="SemiBold" Foreground="#F8FAFC" />
                    <TextBlock x:Name="WorkspaceNameDialogPrompt" Text="Como você quer chamar esta mesa?" Margin="0,7,0,0" FontSize="13" Foreground="#AAB7C8" />
                    <Border Margin="0,22,0,0" Background="#B8121926" BorderBrush="#52647A" BorderThickness="1" CornerRadius="13" Padding="14,4">
                        <TextBox x:Name="WorkspaceNameInput"
                                 Height="38"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F8FAFC"
                                 CaretBrush="#C4B5FD"
                                 SelectionBrush="#738B5CF6"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 PreviewKeyDown="WorkspaceNameInput_PreviewKeyDown" />
                    </Border>
                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="102" Height="40" Margin="0,0,9,0" Click="WorkspaceNameCancel_Click">Cancelar</Button>
                        <Button x:Name="WorkspaceNameConfirmButton" Width="112" Height="40" Background="#8B5CF6" Foreground="White" Click="WorkspaceNameConfirm_Click">Criar mesa</Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="Toast"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,34"
                Background="#EE25282D"
                CornerRadius="18"
                Padding="18,10"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
    </Grid>
</Window>
