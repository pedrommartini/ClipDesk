<Window x:Class="ClipDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClipDesk.Views"
        Title="ClipDesk"
        Icon="Resources/Brand/clipdesk.ico"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowState="Maximized"
        Background="#F4F4F2"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DrawingBrush x:Key="GridBrush"
                      TileMode="Tile"
                      Viewport="0,0,32,32"
                      ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F4F4F2">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#E3E5E8" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="32,0" EndPoint="32,32" />
                                <LineGeometry StartPoint="0,32" EndPoint="32,32" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#25282D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#22000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#33000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="Checkmark" Text="✓" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="Bold" Visibility="Collapsed" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Checkmark" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="7,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource BorderBrush}" /></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="SplitLayout" Background="{DynamicResource SurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="HistoryColumn" Width="0" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="480" />
        </Grid.ColumnDefinitions>
        <views:HistoryView x:Name="HistoryPane" Visibility="Collapsed" />
        <GridSplitter x:Name="HistorySplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />
    <Grid x:Name="Root" Grid.Column="2"
          AllowDrop="True"
          Background="{StaticResource GridBrush}"
          PreviewDragOver="Window_DragOver"
          PreviewDrop="Window_Drop"
          MouseDown="Root_MouseDown">
        <ScrollViewer x:Name="WorkspaceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="WorkspaceScroll_SizeChanged">
        <Canvas x:Name="WorkspaceCanvas"
                AllowDrop="True"
                Background="Transparent"
                ClipToBounds="True"
                PreviewDragOver="Window_DragOver"
                PreviewDrop="Window_Drop"
                SizeChanged="WorkspaceCanvas_SizeChanged" />
        </ScrollViewer>

        <Border x:Name="HistoryDropGlow"
                Margin="18"
                Background="#167046CB"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="20"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock Text="Solte para adicionar à mesa" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="16" />
        </Border>

        <Border x:Name="TopToolbar"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24,52,0,0"
                Background="#B8FFFFFF"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                CornerRadius="22"
                Padding="7">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.12" Color="#475569" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="UndoButton"
                        Width="34"
                        Height="34"
                        Margin="0,0,4,0"
                        Padding="0"
                        Click="UndoButton_Click"
                        ToolTip="Desfazer">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <Button x:Name="RedoButton"
                        Width="34"
                        Height="34"
                        Margin="0,0,4,0"
                        Padding="0"
                        Click="RedoButton_Click"
                        ToolTip="Refazer">
                    <TextBlock Text="&#xE72A;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <Button Width="34"
                        Height="34"
                        Margin="0,0,4,0"
                        Padding="0"
                        Click="HistoryButton_Click"
                        ToolTip="Histórico do clipboard">
                    <TextBlock Text="&#xE823;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <Button x:Name="ThemeButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        Click="ThemeButton_Click"
                        ToolTip="Modo claro/escuro">
                    <TextBlock x:Name="ThemeIcon"
                               Text="&#xE708;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <Button x:Name="StartupButton"
                        Width="34"
                        Height="34"
                        Margin="4,0,0,0"
                        Padding="0"
                        Click="StartupButton_Click"
                        ToolTip="Iniciar com o Windows">
                    <Grid Width="15" Height="15" ToolTip="">
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="#5D77E8" Margin="0,0,1,1" />
                        <Border Grid.Row="0" Grid.Column="1" Background="#7E8EF1" Margin="1,0,0,1" />
                        <Border Grid.Row="1" Grid.Column="0" Background="#8B6DEB" Margin="0,1,1,0" />
                        <Border Grid.Row="1" Grid.Column="1" Background="#B59AFF" Margin="1,1,0,0" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <Button x:Name="WorkspaceButton"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="264,57,0,0"
                Height="34"
                Padding="7,0"
                Click="WorkspaceButton_Click"
                ToolTip="Trocar ou salvar mesa de trabalho">
            <StackPanel Orientation="Horizontal" Opacity="0.72">
                <TextBlock x:Name="WorkspaceNameText" Text="Mesa principal" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="9,3,0,0" />
            </StackPanel>
        </Button>

        <Image x:Name="BrandMark"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
               Margin="27,22,0,0"
               Source="Resources/Brand/clipdesk-icon.png"
               Width="24"
               Height="24"
               Stretch="Uniform"
               IsHitTestVisible="False" />

        <TextBlock Text="ClipDesk" Margin="60,22,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold" IsHitTestVisible="False" />
        <StackPanel x:Name="WorkspaceEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="330">
            <TextBlock Text="Sua mesa, suas ideias." FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextAlignment="Center" />
            <TextBlock Text="Cole com Ctrl+V ou arraste itens do histórico para organizar seu próximo trabalho." Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
        <Border x:Name="TrashZone"
                Width="76"
                Height="82"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,28,34,0"
                Background="#44FFFFFF"
                BorderBrush="#9AA0A8"
                BorderThickness="2"
                CornerRadius="18"
                Opacity="0.78"
                MouseLeftButtonDown="TrashZone_MouseLeftButtonDown"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="TrashScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TrashIcon"
                           Text="&#xE74D;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="28"
                           Foreground="#737983"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="TrashLabel"
                           Text="Lixeira"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="#34373D"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Grid x:Name="FolderOverlay"
              Visibility="Collapsed"
              Opacity="0"
              Background="#B8F4F4F2"
              AllowDrop="True"
              DragOver="FolderOverlay_DragOver"
              Drop="FolderOverlay_Drop"
              MouseMove="FolderOverlay_MouseMove"
              MouseLeftButtonUp="FolderOverlay_MouseLeftButtonUp"
              MouseDown="FolderOverlay_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid HorizontalAlignment="Center"
                  Margin="0,34,0,28">
                <TextBlock x:Name="FolderOverlayTitle"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="56"
                           FontWeight="Light"
                           Foreground="#FAFFFFFF"
                           Cursor="IBeam"
                           MouseLeftButtonDown="FolderOverlayTitle_MouseLeftButtonDown">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25" Color="#53617A" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBox x:Name="FolderOverlayTitleEditor"
                         MinWidth="260"
                         MaxWidth="760"
                         FontSize="56"
                         FontWeight="Light"
                         TextAlignment="Center"
                         Background="#22FFFFFF"
                         BorderBrush="#66FFFFFF"
                         BorderThickness="0,0,0,2"
                         Foreground="#FAFFFFFF"
                         Visibility="Collapsed"
                         LostFocus="FolderOverlayTitleEditor_LostFocus"
                         PreviewKeyDown="FolderOverlayTitleEditor_PreviewKeyDown" />
            </Grid>

            <Border x:Name="FolderPanel"
                    Grid.Row="1"
                    Width="640"
                    Height="470"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#B8DDEAFF"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    CornerRadius="54"
                    Padding="42,38"
                    MouseDown="FolderPanel_MouseDown"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="FolderPanelScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" ShadowDepth="10" Opacity="0.2" Color="#53617A" />
                </Border.Effect>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="FolderItemsPanel"
                               ItemWidth="150"
                               ItemHeight="150" />
                </ScrollViewer>
            </Border>
        </Grid>

        <Border x:Name="Toast"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,34"
                Background="#EE25282D"
                CornerRadius="18"
                Padding="18,10"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
    </Grid>
</Window>
